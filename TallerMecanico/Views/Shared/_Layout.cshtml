<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - MotorLink</title>
    <link href="~/Content/Site.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <script src="~/Scripts/modernizr-2.6.2.js"></script>
</head>
<body>

    <!-- BANNER ARRIBA -->
    <section class="banner">
        <img src="https://img.freepik.com/vector-premium/banner-taller-servicio-reparacion-automoviles-mecanicos-trabajadores-servicio-neumaticos-o-taller-reparacion-automoviles_125133-463.jpg?w=2000"
             alt="Banner Taller"
             class="img-fluid w-100"
             style="max-height: 400px; object-fit: cover;">
    </section>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow">
        <div class="container">

            <a href="@Url.Action("Index","Home")" class="navbar-brand fw-bold d-flex align-items-center">
                <img src="https://th.bing.com/th/id/OIP.Ygp4kjxEwvqIAv2p06pO0gHaHa?w=174&h=180&c=7&r=0&o=7&pid=1.7&rm=3"
                     alt="Logo"
                     style="width:40px; height:40px; margin-right:10px; border-radius:50%;">
                MotorLink
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        @Html.ActionLink("Inicio", "Index", "Home", null, new { @class = "nav-link" })
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink("Servicios", "Index", "Servicios", null, new { @class = "nav-link" })
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink("Citas", "Index", "Citas", null, new { @class = "nav-link" })
                    </li>

                    <li class="nav-item">
                        @Html.ActionLink("Contacto", "Index", "Contactos", null, new { @class = "nav-link" })
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <!-- CONTENIDO -->
    <main class="container my-4">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="bg-dark text-white text-center py-3">
        <div class="container">
            <p class="mb-0">
                &copy; @DateTime.Now.Year - Taller Mecánico MotorLink | Todos los derechos reservados
            </p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Scripts/jquery-1.10.2.min.js"></script>

</body>
</html>